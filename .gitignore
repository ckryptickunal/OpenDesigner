# Secrets: never commit
.env
.env.*
*.pem
*.key

# Local and generated
.DS_Store
__pycache__/
*.pyc
node_modules/

# Release zips (tools/build_dist.py)
dist/

# Learning wiki: third-party raw text stays local (tools/wiki.py re-fetches it)
learn/raw/
learn/raw_*/
.venv-wiki/

# Detached worktrees holding uncommitted pull-request fixes
.worktrees/

# Taste poll screen images: Mobbin's terms do not allow re-hosting them, so they stay on the
# maintainers' machines (skills/opendesigner/assets/taste/library.json lists them, without images)
taste-screens/

# videos: scripts and notes are committed; renders, audio, images and fonts stay local (owner, 2026-10-14)
videos/**/*.mp4
videos/**/*.mov
videos/**/*.webm
videos/**/*.wav
videos/**/*.mp3
videos/**/*.jpg
videos/**/*.jpeg
videos/**/*.png
videos/**/*.woff2
videos/**/renders/
videos/**/node_modules/

# plugin eval raw runs (curated summaries live in evals/agent/)
evals/results/

# README image captures (brand/kit/readme/src/render.py --library-from)
brand/kit/readme/src/shots/
