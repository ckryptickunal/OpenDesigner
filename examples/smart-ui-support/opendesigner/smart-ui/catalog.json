    "cancel",
    "approve"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "approval-prompt",
      "group": "act",
      "name": "Approval prompt",
      "use": "just before an action that sends, pays, books or deletes, so the person confirms it first",
      "use_when": [
       "an assistant is about to do something that changes data (send, pay, book, delete) and the person must say yes first"
      ],
      "avoid_when": [
       "the action already happened: use receipt",
       "the person still has to fill in values: use form-fields",
       "a bill or request that goes through several approvers: use approval-panel"
      ],
      "tags": [
       "confirm",
       "approval",
       "dialog",
       "warning",
       "destructive action"
      ],
      "intents": [
       "confirm before",
       "approve",
       "are you sure",
       "pay",
       "send",
       "delete",
       "cancel my",
       "book it"
      ],
      "width": "narrow",
      "name_from": "title"
     }
    }
   }
