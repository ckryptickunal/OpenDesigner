     "maxLength": 24
    },
    "total_value": {
     "type": "string",
     "maxLength": 16
    },
    "note": {
     "type": "string",
     "maxLength": 160
    },
    "primary": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "label",
      "event"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40
      },
      "a11y_label": {
       "type": "string",
       "maxLength": 120
      },
      "event": {
       "$ref": "#/$defs/Event"
      }
     },
     "x-od-effect": "none"
    },
    "secondary": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "label",
      "event"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40
      },
      "a11y_label": {
       "type": "string",
       "maxLength": 120
      },
      "event": {
       "$ref": "#/$defs/Event"
      }
     },
     "x-od-effect": "none"
    }
   },
   "required": [
    "component",
    "id",
    "status",
    "title",
    "lines"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "receipt",
      "group": "confirm",
      "name": "Receipt",
      "use": "right after a booking, payment, order or change went through (or did not), to say what happened",
      "use_when": [
       "an action finished and the person needs the outcome, its reference number and what to do next"
      ],
      "avoid_when": [
       "the action has not happened yet and needs a yes: use approval-prompt",
       "the action failed and can be tried again: use error-retry",
       "a long history of payments or orders: use data-table"
      ],
      "tags": [
       "receipt",
       "confirmation",
       "booking",
       "order",
       "summary"
      ],
      "intents": [
