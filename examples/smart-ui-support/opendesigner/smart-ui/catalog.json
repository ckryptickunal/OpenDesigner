     "type": "string",
     "maxLength": 120
    },
    "subtitle": {
     "type": "string",
     "maxLength": 120
    },
    "stats": {
     "type": "array",
     "minItems": 0,
     "maxItems": 12,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string",
        "maxLength": 120
       },
       "value": {
        "type": "string",
        "maxLength": 120
       },
       "badge": {
        "type": "string",
        "maxLength": 120
       }
      },
      "required": [
       "label",
       "value"
      ],
      "x-od-name-from": "label"
     }
    },
    "currency": {
     "type": "string",
     "maxLength": 120
    },
    "axis_max": {
     "type": "string",
     "maxLength": 120
    },
    "budget": {
     "type": "string",
     "maxLength": 120
    },
    "months": {
     "type": "array",
     "minItems": 0,
     "maxItems": 12,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "spent": {
        "type": "number",
        "x-od-measure": true
       },
       "forecast": {
        "type": "number",
        "x-od-measure": true
       },
       "label": {
        "type": "string",
        "maxLength": 120
       },
       "short": {
        "type": "string",
        "maxLength": 120
       }
      },
      "required": [
       "spent",
       "label",
       "short"
      ],
      "x-od-name-from": "label"
     }
    },
    "note": {
     "type": "string",
     "maxLength": 120
    }
   },
   "required": [
    "component",
    "id",
    "title",
    "currency"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "bar-chart",
      "group": "data",
      "name": "Monthly spend chart",
      "use": "for monthly spend or usage against a budget, with a forecast",
      "use_when": [],
      "avoid_when": [],
      "tags": [
       "bar chart",
       "spend",
       "budget",
       "forecast",
       "billing",
       "tooltip"
      ],
      "intents": [
       "by month",
       "per month",
       "compare amounts",
       "bar chart",
       "spend over",
       "monthly",
       "how much each"
      ],
      "width": "medium",
      "name_from": "title"
     }
    }
   }
  },
  "LineChart": {
   "type": "object",
   "description": "One or two values over time as lines on a light grid, with the highest and lowest marked and a button that shows the same numbers as a table.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "LineChart"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
