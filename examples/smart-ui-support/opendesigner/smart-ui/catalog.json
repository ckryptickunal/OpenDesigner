       "badge": {
        "type": "string",
        "maxLength": 18
       },
       "price": {
        "type": "string",
        "maxLength": 14
       },
       "price_note": {
        "type": "string",
        "maxLength": 24
       },
       "choose": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "label",
         "event"
        ],
        "properties": {
         "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
         },
         "a11y_label": {
          "type": "string",
          "maxLength": 120
         },
         "event": {
          "$ref": "#/$defs/Event"
         }
        },
        "x-od-effect": "none"
       }
      },
      "required": [
       "name",
       "choose"
      ],
      "x-od-name-from": "name"
