  "ProgressStatus": {
   "type": "object",
   "description": "Where something stands: a status line coloured by its tone, an optional progress bar, the steps done and still to come, and when it was last updated.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "ProgressStatus"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
    "@accessibility": {
     "$ref": "#/$defs/Accessibility"
    },
    "@metadata": {
     "$ref": "#/$defs/Metadata"
    },
    "title": {
     "type": "string",
     "maxLength": 48
    },
    "tone": {
     "type": "string",
     "enum": [
      "neutral",
      "info",
      "success",
      "warning",
      "danger"
     ],
     "x-od-token": true
    },
    "status": {
     "type": "string",
     "maxLength": 60
    },
    "progress": {
     "type": "number",
     "minimum": 0,
     "maximum": 100,
     "x-od-measure": true
    },
    "steps": {
     "type": "array",
     "minItems": 0,
     "maxItems": 6,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "state": {
        "type": "string",
        "enum": [
         "done",
         "next",
         "now"
        ]
       },
       "label": {
        "type": "string",
        "maxLength": 60
       },
       "time": {
        "type": "string",
        "maxLength": 32
       }
      },
      "required": [
       "state",
       "label"
      ],
      "x-od-name-from": "label"
     }
    },
    "updated": {
     "type": "string",
     "maxLength": 40
    }
   },
   "required": [
    "component",
    "id",
    "title",
    "tone",
    "status"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "progress-status",
      "group": "data",
      "name": "Progress status",
      "use": "to answer where an order, refund, request or job is right now",
      "use_when": [
       "an answer to 'where is my order', 'is it done yet' or 'what happens next', with one status and a few steps"
      ],
      "avoid_when": [
       "a list of tasks the person still has to do: use setup-steps",
       "a finished action with its reference number: use receipt",
       "something that failed and can be retried: use error-retry",
       "a live delivery on a map: use delivery-tracker"
      ],
      "tags": [
       "status",
       "progress",
       "steps",
       "tracking",
       "timeline"
      ],
      "intents": [
       "status",
       "progress",
       "where is my",
       "how far",
       "tracking",
       "is it done",
       "delivery status",
       "refund status"
      ],
      "width": "narrow",
      "name_from": "title"
     }
    }
   }
  },
  "Comparison": {
   "type": "object",
   "description": "Two to four options side by side: each with its name, price and a Choose button, then one row per attribute so the differences line up.",
