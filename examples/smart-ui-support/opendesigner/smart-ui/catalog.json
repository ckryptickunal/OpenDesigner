     "maxLength": 48
    },
    "summary": {
     "type": "string",
     "maxLength": 90
    },
    "unit": {
     "type": "string",
     "maxLength": 24
    },
    "x_label": {
     "type": "string",
     "maxLength": 16
    },
    "series": {
     "type": "string",
     "maxLength": 24
    },
    "series2": {
     "type": "string",
     "maxLength": 24
    },
    "points": {
     "type": "array",
     "minItems": 2,
     "maxItems": 24,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string",
        "maxLength": 12
       },
       "value": {
        "type": [
         "number",
         "null"
        ]
       },
       "value2": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "label",
       "value"
      ],
      "x-od-name-from": "label"
     }
    }
   },
   "required": [
    "component",
    "id",
    "title",
    "unit",
    "series",
    "points"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "line-chart",
      "group": "data",
      "name": "Line chart",
      "use": "for a trend over time, such as a price, a usage figure or a measurement week by week",
      "use_when": [
       "an answer about how one or two numbers changed over 2 to 24 periods"
      ],
      "avoid_when": [
       "amounts per period to compare side by side, or against a budget: use bar-chart",
       "a share of a whole: use donut-breakdown",
       "one current number with no history: use kpi-strip"
      ],
      "tags": [
       "line chart",
       "trend",
       "time series",
       "history",
       "table"
      ],
      "intents": [
       "trend",
       "over time",
       "line chart",
       "history",
       "how has it changed",
       "price history",
       "growth"
      ],
      "width": "medium",
      "name_from": "title"
     }
    }
   }
  },
