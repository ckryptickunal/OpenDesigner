     "maxItems": 10,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string",
        "maxLength": 32
       },
       "values": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
