  "Receipt": {
   "type": "object",
   "description": "What just happened: a status line in its tone, what was done, a reference number, the lines that matter, a total, a note and up to two next steps.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "Receipt"
