{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://opendesigner.dev/catalogs/tallyhaus/v1/catalog.json",
 "catalogId": "https://opendesigner.dev/catalogs/tallyhaus/v1/catalog.json",
 "protocolVersion": "1.0",
 "title": "Tallyhaus: Smart UI catalog",
 "description": "Components an assistant may answer with, built only from this system's tokens. Generated by OpenDesigner smartui.py catalog; do not edit.",
 "instructions": "Answer in plain text first. Show a component only when it does a job text cannot: a list to pick from, numbers to compare, a form to fill, a step to approve. A short factual answer stays text (R1). One component per answer unless the person asked for more (R2). Actions that change data (book, pay, send, delete) are buttons the person presses; never claim they happened (R3). Use only the components and properties in this catalog; there are no colour, size, style, class or URL-of-your-choice properties (R4). Every number must come from the data you were given; leave a value out when you do not have it (R6). Text is plain: no HTML or markdown.",
 "components": {
  "KeyFacts": {
   "type": "object",
   "description": "The facts about one thing as label and value rows, with a short note where it helps and a status colour on values that are a status.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "KeyFacts"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
    "@accessibility": {
     "$ref": "#/$defs/Accessibility"
    },
    "@metadata": {
     "$ref": "#/$defs/Metadata"
    },
    "title": {
     "type": "string",
     "maxLength": 70
    },
    "subtitle": {
     "type": "string",
     "maxLength": 90
    },
    "facts": {
     "type": "array",
     "minItems": 2,
     "maxItems": 10,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string",
        "maxLength": 32
       },
       "value": {
        "type": "string",
        "maxLength": 48
       },
       "tone": {
        "type": "string",
        "enum": [
         "neutral",
         "accent",
         "success",
         "warning",
         "danger",
         "info"
        ],
        "x-od-token": true
       },
       "note": {
        "type": "string",
        "maxLength": 80
       }
      },
      "required": [
       "label",
       "value"
      ],
      "x-od-name-from": "label"
     }
    }
   },
   "required": [
    "component",
    "id",
    "title",
    "facts"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "key-facts",
      "group": "answer",
      "name": "Key facts",
      "use": "to give the details of one booking, order, place or product at a glance",
      "use_when": [
       "the person asks for the details of one thing: a flight, a parcel, an apartment, a plan"
      ],
      "avoid_when": [
       "several things side by side: use comparison",
       "two to four headline numbers for a period: use kpi-strip",
       "a step-by-step status over time: use progress-status"
      ],
      "tags": [
       "facts",
       "details",
       "specs",
       "summary",
       "at a glance"
      ],
      "intents": [
       "key facts",
       "at a glance",
       "details of",
       "specs",
       "facts about",
       "what are the details",
       "opening hours",
       "baggage allowance"
      ],
      "width": "medium",
      "name_from": "title"
     }
    }
   }
  },
  "DataTable": {
   "type": "object",
   "description": "A plain table of up to 50 rows with a title and a summary line, sortable by any column and shown ten rows to a page.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "DataTable"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
    "@accessibility": {
     "$ref": "#/$defs/Accessibility"
    },
    "@metadata": {
     "$ref": "#/$defs/Metadata"
    },
    "title": {
     "type": "string",
     "maxLength": 60
    },
    "summary": {
     "type": "string",
     "maxLength": 120
    },
    "columns": {
     "type": "array",
     "minItems": 2,
     "maxItems": 6,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string",
        "maxLength": 24
       },
       "align": {
        "type": "string",
        "enum": [
         "start",
         "end"
        ]
       }
      },
      "required": [
       "label"
      ],
      "x-od-name-from": "label"
     }
    },
    "rows": {
     "type": "array",
     "minItems": 1,
     "maxItems": 50,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "cells": {
        "type": "array",
        "minItems": 2,
        "maxItems": 6,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "text": {
           "type": "string",
           "maxLength": 80
          }
         },
         "required": [
          "text"
         ],
         "x-od-name-from": "text"
        }
       }
      },
      "required": [
       "cells"
      ]
     }
    },
    "more_note": {
     "type": "string",
     "maxLength": 120
    }
   },
   "required": [
    "component",
    "id",
    "columns",
    "rows"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "data-table",
      "group": "data",
      "name": "Data table",
      "use": "for a list of records an assistant or a report fills in, such as invoices, orders or transactions",
      "use_when": [
       "an answer that lists records with the same few fields, where the person may want to sort or page through them"
      ],
      "avoid_when": [
       "two to four headline totals: use kpi-strip",
       "numbers over time: use line-chart or bar-chart",
       "a handful of options to pick from: use result-list or comparison",
       "rows the person must select and act on in bulk: use receipts-table"
      ],
      "tags": [
       "table",
       "rows",
       "sort",
       "pagination",
       "records"
      ],
      "intents": [
       "table",
       "list all",
       "rows",
       "every transaction",
       "export",
       "show me the records",
       "sort by",
       "invoices",
       "orders"
      ],
      "width": "medium",
      "name_from": "title"
     }
    }
   }
  },
  "BarChart": {
   "type": "object",
   "description": "Six months of spend as bars, with the current month's forecast hatched on top, a dashed budget line and a tooltip on the bar you point at.",
   "additionalProperties": false,
   "properties": {
