      "opendesigner": {
        "mode": "dark",
        "evidence": [
          "DC-L01-11",
          "DC-L01-12",
          "DC-L01-17",
          "DC-L01-18",
          "DC-L01-19",
          "DC-L04-12",
          "DC-L04-13"
        ]
      }
    },
