{
  "color": {
    "$type": "color",
    "$description": "Semantic color roles, light mapping. Names never change across modes; only values do. Dark is a separate mapping, never an inversion (DC-L01-18).",
    "$extensions": {
      "opendesigner": {
        "mode": "light",
        "evidence": [
          "DC-L01-11",
          "DC-L01-12",
          "DC-L01-17",
          "DC-L01-18",
          "DC-L01-19",
          "DC-L04-12",
          "DC-L04-13"
        ]
      }
    },
    "surface": {
      "sunken": {
        "$value": "{color.neutral.light.2}",
        "$description": "Wells, code blocks, page gutters."
      },
      "base": {
        "$value": "{color.neutral.light.1}",
        "$description": "The page background."
      },
      "raised": {
        "$value": "{color.white}",
        "$description": "Cards and panels on the page."
      },
      "overlay": {
        "$value": "{color.white}",
        "$description": "Menus, popovers, dialogs; always with elevation.floating or elevation.overlay."
      },
      "nav": {
        "$value": "{color.accent.light.9}",
        "$description": "Colored navigation (Energy 67+ with brand chrome allowed by Expression 67+)."
      },
      "tinted": {
        "$value": "{color.accent.light.3}",
        "$description": "Tinted container (Colorfulness 50+, L09 X rubric; Q-color-05)."
      },
      "glass": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            1.0,
            1.0
          ],
          "hex": "#ffffff",
          "alpha": 0.72
        },
        "$description": "Glass for controls and navigation only, never content (DC-L04-15)."
      },
      "glass-fallback": {
        "$value": "{color.white}",
        "$description": "Solid twin under Reduce Transparency and Increase Contrast (DC-L04-16)."
      },
      "glass-dimming": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0,
            0.0,
            0.0
          ],
          "hex": "#000000",
          "alpha": 0.35
        },
        "$description": "35% dimming under clear glass over bright content (S-L15-073)."
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.light.12}",
        "$description": "Body copy, headings, labels (guaranteed >= 7:1 on steps 1-5)."
      },
      "secondary": {
        "$value": "{color.neutral.light.11}",
        "$description": "Supporting text (guaranteed >= the text minimum on surfaces and neutral fills 1-4)."
      },
      "tertiary": {
        "$value": "{color.neutral.light.10}",
        "$description": "Captions and placeholders (still meets the text minimum on surfaces 1-4)."
      },
      "disabled": {
        "$value": "{color.neutral.light.8}",
        "$description": "Disabled labels; exempt from contrast minimums (WCAG 1.4.3 exception)."
      },
      "inverse": {
        "$value": "{color.white}",
        "$description": "Text on color.bg.inverse (tooltips, toasts)."
      },
      "link": {
        "$value": "{color.accent.light.11}",
        "$description": "Links. Underline them in running text so color is not the only cue."
      },
      "accent": {
        "$value": "{color.accent.light.11}",
        "$description": "Accent text and selected labels."
      },
      "on-accent": {
        "$value": "{color.neutral.light.12}",
        "$description": "Text and icons on color.bg.accent.bold* (auto-picked light or dark, S-L06-094)."
      },
      "on-action": {
        "$value": "{color.neutral.light.12}",
        "$description": "Text on the primary action fill."
      },
      "on-brand": {
