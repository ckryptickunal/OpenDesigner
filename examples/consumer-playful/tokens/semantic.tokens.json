{
  "font": {
    "family": {
      "$type": "fontFamily",
      "text": {
        "$value": [
          "Nunito",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Text face for UI and body (DC-L02-01)."
      },
      "display": {
        "$value": "{font.family.text}",
        "$description": "Display face for headings (Apple, Google and Linear split display and text faces, DC-L06-07)."
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ],
        "$description": "Code, tokens, tabular values."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "4 weights: body 400, labels 500, headings 750 (DC-L02-15; Energy sets heading weight, S-L06-031).",
      "body": {
        "$value": 400
      },
      "label": {
        "$value": 500
      },
      "heading": {
        "$value": 750
      },
      "display": {
        "$value": 850,
        "$description": "Display sizes (32px and up) only."
      }
    }
  },
  "text": {
    "$type": "typography",
    "$description": "Semantic text styles (role x size). lineHeight is a unitless multiplier as DTCG requires; px is in $extensions.",
    "$extensions": {
      "opendesigner": {
        "evidence": [
          "DC-L02-07",
          "DC-L02-13",
          "DC-L02-14",
          "DC-L02-15",
          "DC-L15-02"
        ],
        "scripts": {}
      }
    },
    "body": {
      "sm": {
        "$value": {
          "fontFamily": "{font.family.text}",
          "fontSize": "{font.size.12}",
          "fontWeight": "{font.weight.body}",
          "letterSpacing": {
            "value": 0.24,
            "unit": "px"
          },
          "lineHeight": 1.3333
        },
        "$extensions": {
          "opendesigner": {
            "lineHeightPx": 16,
            "letterSpacingEm": 0.02,
            "use": "Helper text, timestamps, captions.",
            "avoid": "Anything read at length."
          }
        }
      },
      "md": {
        "$value": {
          "fontFamily": "{font.family.text}",
          "fontSize": "{font.size.16}",
          "fontWeight": "{font.weight.body}",
          "letterSpacing": {
            "value": 0.0,
            "unit": "px"
          },
          "lineHeight": 1.5
        },
        "$extensions": {
          "opendesigner": {
            "lineHeightPx": 24,
            "letterSpacingEm": 0.0,
            "use": "Default UI text: forms, tables, descriptions.",
            "avoid": "Long articles when body.lg exists."
          }
        }
      },
      "lg": {
        "$value": {
          "fontFamily": "{font.family.text}",
          "fontSize": "{font.size.21}",
          "fontWeight": "{font.weight.body}",
          "letterSpacing": {
            "value": 0.0,
            "unit": "px"
          },
          "lineHeight": 1.3333
        },
        "$extensions": {
          "opendesigner": {
            "lineHeightPx": 28,
            "letterSpacingEm": 0.0,
            "use": "Long-form reading, onboarding copy.",
            "avoid": "Dense tables and forms."
          }
        }
      }
    },
    "label": {
      "sm": {
        "$value": {
          "fontFamily": "{font.family.text}",
          "fontSize": "{font.size.12}",
          "fontWeight": "{font.weight.label}",
          "letterSpacing": {
            "value": 0.6,
            "unit": "px"
          },
          "lineHeight": 1.3333
        },
        "$extensions": {
          "opendesigner": {
            "lineHeightPx": 16,
            "letterSpacingEm": 0.05,
            "use": "Overlines in capitals with wide tracking (DC-L02-18).",
            "avoid": "Sentences; scripts without case.",
            "textTransform": "uppercase"
          }
        }
      },
      "md": {
        "$value": {
          "fontFamily": "{font.family.text}",
          "fontSize": "{font.size.12}",
          "fontWeight": "{font.weight.label}",
          "letterSpacing": {
            "value": 0.24,
            "unit": "px"
          },
          "lineHeight": 1.3333
        },
        "$extensions": {
          "opendesigner": {
            "lineHeightPx": 16,
            "letterSpacingEm": 0.02,
            "use": "Small control labels, badges, dense tabs.",
            "avoid": "Body text."
          }
        }
      },
      "lg": {
        "$value": {
          "fontFamily": "{font.family.text}",
          "fontSize": "{font.size.16}",
          "fontWeight": "{font.weight.label}",
          "letterSpacing": {
