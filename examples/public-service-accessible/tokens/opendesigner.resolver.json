{
  "name": "Public Service Accessible",
  "version": "2025.10",
  "description": "DTCG Resolver Module 2025.10. Orthogonal modifiers (no two set the same token): density x motion (S-L07-004, DC-L07-15, DC-L07-17).",
  "sets": {
    "foundation": {
      "description": "Primitives and mode-independent tokens.",
      "sources": [
        {
          "$ref": "primitives.tokens.json"
        },
        {
          "$ref": "semantic.tokens.json"
        }
      ]
    },
    "theme": {
      "description": "Single color scheme (light).",
      "sources": [
        {
          "$ref": "semantic.color.light.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "density": {
      "description": "Semantic spacing density; primitives and target minimums never change (DC-L03-11).",
      "contexts": {
        "spacious": [
          {
            "$ref": "semantic.density.spacious.tokens.json"
          }
        ],
        "comfortable": [
          {
            "$ref": "semantic.density.comfortable.tokens.json"
          }
        ],
        "compact": [
          {
            "$ref": "semantic.density.compact.tokens.json"
          }
        ]
      },
      "default": "spacious"
    },
    "motion": {
      "description": "Reduced motion as a token mode (DC-L04-25; WCAG 2.3.3 treated as required).",
      "contexts": {
        "standard": [
          {
            "$ref": "motion.standard.tokens.json"
          }
        ],
        "reduced": [
          {
            "$ref": "motion.reduced.tokens.json"
          }
        ]
      },
      "default": "reduced"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/foundation"
    },
    {
      "$ref": "#/sets/theme"
    },
    {
      "$ref": "#/modifiers/density"
    },
    {
      "$ref": "#/modifiers/motion"
    }
  ]
}
