{
  "space": {
    "$type": "dimension",
    "$description": "Semantic spacing, comfortable density: aliases into the ladder, shifted +0 step (DC-L03-10, DC-L03-11). Parents own spacing; children never set outer margins (DC-L03-04).",
    "$extensions": {
      "opendesigner": {
        "density": "comfortable",
        "innerOuterRatio": 2.5,
        "excluded": [
          "menus",
          "snackbars",
          "dialogs"
        ],
        "evidence": [
          "DC-L03-04",
          "DC-L03-10",
          "DC-L03-11",
          "DC-L03-24",
          "S-L03-029"
        ]
      }
    },
    "inset": {
      "xs": {
        "$value": "{space.5}"
      },
      "sm": {
        "$value": "{space.10}"
      },
      "md": {
        "$value": "{space.15}"
      },
      "lg": {
        "$value": "{space.20}"
      },
      "xl": {
        "$value": "{space.30}"
      }
    },
    "stack": {
      "xs": {
        "$value": "{space.5}"
      },
      "sm": {
        "$value": "{space.10}"
      },
      "md": {
        "$value": "{space.15}"
      },
      "lg": {
        "$value": "{space.20}"
      },
      "xl": {
        "$value": "{space.30}"
      }
    },
    "inline": {
      "xs": {
        "$value": "{space.5}"
      },
      "sm": {
        "$value": "{space.10}"
      },
      "md": {
        "$value": "{space.15}"
      }
    },
    "section": {
      "sm": {
        "$value": "{space.40}",
        "$description": "Outer gap between groups: at least ratio x the inner gap (inner < outer, L15 P16)."
      },
      "md": {
        "$value": "{space.50}",
        "$description": "Outer gap between groups: at least ratio x the inner gap (inner < outer, L15 P16)."
      },
      "lg": {
        "$value": "{space.80}",
        "$description": "Outer gap between groups: at least ratio x the inner gap (inner < outer, L15 P16)."
      }
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$description": "Control heights, comfortable (DC-L03-07). Hit areas never shrink below size.target.min.",
      "sm": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 40,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 48,
          "unit": "px"
        }
      }
    }
  }
}
