{
  "motion": {
    "transition": {
      "$type": "transition",
      "$description": "Semantic transitions, standard motion. Reduced motion is a token mode: travel becomes opacity, feedback stays (DC-L04-25). flags.motionOff is set, so standard equals reduced (GOV.UK posture, L09 M8).",
      "feedback": {
        "$value": {
          "duration": "{motion.duration.instant}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.standard}"
        },
        "$description": "Color and opacity feedback stays (reduced motion keeps feedback, DC-L04-25)."
      },
      "enter": {
        "$value": {
          "duration": "{motion.duration.instant}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.standard}"
        },
        "$description": "Fade only: no translate or scale."
      },
      "exit": {
        "$value": {
          "duration": "{motion.duration.instant}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.standard}"
        },
        "$description": "Fade only."
      },
      "move": {
        "$value": {
          "duration": "{motion.duration.instant}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.standard}"
        },
        "$description": "Travel removed: position changes are instant."
      },
      "expand": {
        "$value": {
          "duration": "{motion.duration.instant}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.standard}"
        },
        "$description": "Fade only."
      }
    }
  }
}
