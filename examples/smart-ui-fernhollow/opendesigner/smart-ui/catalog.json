      "slug": "comparison",
      "group": "choose",
      "name": "Comparison",
      "use": "when someone is choosing between a few fares, plans or memberships and wants the differences in one view",
      "use_when": [
       "two to four options of the same kind that differ on a few named attributes, such as fare types or plan tiers"
