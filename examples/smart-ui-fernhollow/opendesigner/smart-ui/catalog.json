         "start",
         "end"
        ]
       }
      },
      "required": [
       "label"
      ],
      "x-od-name-from": "label"
     }
    },
    "rows": {
     "type": "array",
     "minItems": 1,
     "maxItems": 50,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "cells": {
        "type": "array",
        "minItems": 2,
        "maxItems": 6,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "text": {
           "type": "string",
           "maxLength": 80
          }
         },
         "required": [
          "text"
         ],
         "x-od-name-from": "text"
        }
       }
      },
      "required": [
       "cells"
      ]
     }
    },
    "more_note": {
     "type": "string",
     "maxLength": 120
    }
   },
   "required": [
    "component",
    "id",
    "columns",
    "rows"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "data-table",
      "group": "data",
      "name": "Data table",
      "use": "for a list of records an assistant or a report fills in, such as invoices, orders or transactions",
      "use_when": [
       "an answer that lists records with the same few fields, where the person may want to sort or page through them"
      ],
      "avoid_when": [
       "two to four headline totals: use kpi-strip",
       "numbers over time: use line-chart or bar-chart",
       "a handful of options to pick from: use result-list or comparison",
       "rows the person must select and act on in bulk: use receipts-table"
      ],
      "tags": [
       "table",
       "rows",
       "sort",
       "pagination",
       "records"
      ],
      "intents": [
       "table",
       "list all",
       "rows",
       "every transaction",
       "export",
       "show me the records",
       "sort by",
       "invoices",
       "orders"
      ],
      "width": "medium",
      "name_from": "title"
     }
    }
   }
  },
  "ProgressStatus": {
   "type": "object",
   "description": "Where something stands: a status line coloured by its tone, an optional progress bar, the steps done and still to come, and when it was last updated.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "ProgressStatus"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
