     "type": "string",
     "maxLength": 48
    },
    "tone": {
     "type": "string",
     "enum": [
      "neutral",
      "info",
      "success",
      "warning",
      "danger"
     ],
     "x-od-token": true
    },
    "status": {
     "type": "string",
     "maxLength": 60
    },
    "progress": {
     "type": "number",
     "minimum": 0,
     "maximum": 100,
     "x-od-measure": true
    },
    "steps": {
     "type": "array",
     "minItems": 0,
     "maxItems": 6,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "state": {
        "type": "string",
