{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://opendesigner.dev/catalogs/fernhollow/v1/catalog.json",
 "catalogId": "https://opendesigner.dev/catalogs/fernhollow/v1/catalog.json",
 "protocolVersion": "1.0",
 "title": "Fernhollow: Smart UI catalog",
 "description": "Components an assistant may answer with, built only from this system's tokens. Generated by OpenDesigner smartui.py catalog; do not edit.",
 "instructions": "Answer in plain text first. Show a component only when it does a job text cannot: a list to pick from, numbers to compare, a form to fill, a step to approve. When the person asks to see several records (which invoices, my orders), show them in a list or table, not bullets, even two. A question about one thing (when is the next invoice due?) is a short factual answer and stays text (R1). One component per answer unless the person asked for more (R2). Actions that change data (book, pay, send, delete) are buttons the person presses; never claim they happened (R3). Use only the components and properties in this catalog; there are no colour, size, style, class or URL-of-your-choice properties (R4). Every number must come from the data you were given; leave a value out when you do not have it (R6). Text is plain: no HTML or markdown.",
 "components": {
  "KeyFacts": {
   "type": "object",
   "description": "The facts about one thing as label and value rows, with a short note where it helps and a status colour on values that are a status.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "KeyFacts"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
    "@accessibility": {
     "$ref": "#/$defs/Accessibility"
    },
    "@metadata": {
     "$ref": "#/$defs/Metadata"
    },
    "title": {
     "type": "string",
     "maxLength": 70
    },
    "subtitle": {
     "type": "string",
     "maxLength": 90
    },
    "facts": {
     "type": "array",
     "minItems": 2,
     "maxItems": 10,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string",
        "maxLength": 32
       },
       "value": {
        "type": "string",
        "maxLength": 48
       },
       "tone": {
        "type": "string",
        "enum": [
         "neutral",
         "accent",
         "success",
         "warning",
         "danger",
         "info"
        ],
        "x-od-token": true
       },
       "note": {
        "type": "string",
        "maxLength": 80
       }
      },
      "required": [
       "label",
       "value"
      ],
      "x-od-name-from": "label"
     }
    },
    "action": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "label",
      "event"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40
      },
      "a11y_label": {
       "type": "string",
       "maxLength": 120
      },
      "event": {
       "$ref": "#/$defs/Event"
      }
     },
     "x-od-effect": "none"
    }
   },
   "required": [
    "component",
    "id",
    "title",
    "facts"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "key-facts",
      "group": "answer",
      "name": "Key facts",
      "use": "to give the details of one booking, order, place or product at a glance",
      "use_when": [
       "the person asks for the details of one thing: a flight, a parcel, an apartment, a plan"
      ],
      "avoid_when": [
       "several things side by side: use comparison",
       "two to four headline numbers for a period: use kpi-strip",
       "a step-by-step status over time: use progress-status"
      ],
      "tags": [
       "facts",
       "details",
       "specs",
       "summary",
       "at a glance"
      ],
      "intents": [
       "key facts",
       "at a glance",
       "details of",
       "specs",
       "facts about",
       "what are the details",
       "opening hours",
       "baggage allowance"
      ],
      "width": "medium",
      "name_from": "title"
     }
    }
   }
  },
  "DataTable": {
   "type": "object",
   "description": "A plain table of up to 50 rows with a title and a summary line, sortable by any column and shown ten rows to a page.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "DataTable"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
    "@accessibility": {
     "$ref": "#/$defs/Accessibility"
    },
    "@metadata": {
     "$ref": "#/$defs/Metadata"
    },
