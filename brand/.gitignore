# Large or temporary outputs stay on the maintainer's disk; the sources that make them are committed.
# Full-size renders of the showcase (2x and 3x PNGs). The gallery uses showcase/_thumbs/ and links to each live page.
showcase/**/shot*.png
showcase/**/*.png
# Gallery thumbnails (showcase/_thumbs/*.jpg) are committed: owner decision 2026-10-14, reviewed by scan_pr.py, not blocked.
# Each piece's engine outputs can be rebuilt from its state.json; keep only the CSS its index.html loads.
showcase/*/*/opendesigner/build/*
!showcase/*/*/opendesigner/build/css/
showcase/*/*/opendesigner/tokens/
showcase/*/*/opendesigner/preview/
showcase/*/*/opendesigner/preview.html
showcase/*/*/opendesigner/overview.html
# Unfinished mockups (the builder stopped before finishing).
showcase/mockups/
# The first brand kit (warm black, ember, Geist), replaced by the cobalt system; kept locally until the new kit is exported.
export/
# Local test renders of the artifact's preview cards.
design-system/_local/
__pycache__/
# Per-piece standards snapshots and search caches are regenerated by the engine and the illustrate skill.
showcase/*/*/opendesigner/standards-state.json
showcase/*/*/opendesigner/illustrations/responses/
showcase/*/*/opendesigner/standards.md
