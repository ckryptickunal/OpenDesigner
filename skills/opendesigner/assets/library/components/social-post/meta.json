{
  "name": "Social post",
  "summary": "A feed post: the author's photo with a follow button, a photo, like, comment, share and save, a like count that changes, a caption that opens with \"more\" and the top comment.",
  "use": "in a social or creator feed, for one photo post",
  "type": "content",
  "style": "friendly",
  "industries": [
    "social",
    "media"
  ],
  "tags": [
    "feed",
    "post",
    "like",
    "photo",
    "caption",
    "social"
  ],
  "states": [
    "liked",
    "saved",
    "following",
    "caption open",
    "double-tap like",
    "hover",
    "focus"
  ],
  "source": null,
  "a11y": "Like, save and follow are toggle buttons with aria-pressed, the like count is announced politely when it changes, \"more\" opens the caption with aria-expanded, and the photo has a text description.",
  "width": "narrow",
  "photos": [
    {
      "img": "photo-1512531123205-560f5974e686",
      "author": "Shea Rouda",
      "page": "Vtl6cOhO87Y"
    },
    {
      "img": "photo-1705645930353-0e335311ef20",
      "author": "Danny Postma",
      "page": "zNxOw2JFNKs"
    },
    {
      "img": "photo-1596580817363-a4a8f67d4bc8",
      "author": "Dorrell Tibbs",
      "page": "gisFZKWpKQ4"
    }
  ],
  "spec": {
    "use_when": [
      "a community or club app where members share photos and react to each other's"
    ],
    "avoid_when": [
      "a blog post or changelog entry to read: use article-card",
      "a text conversation between people: use comment-thread or chat-thread",
      "a row of creators to follow: use follow-suggestions"
    ],
    "parts": [
      {
        "name": "avatar",
        "selector": ".odl-ring .odl-av",
        "what": "the author's photo in an accent ring",
        "slot": "media"
      },
      {
        "name": "author",
        "selector": ".odl-who b",
        "what": "the author's handle",
        "slot": "text"
      },
      {
        "name": "place",
        "selector": ".odl-who span",
        "what": "where the photo was taken",
        "slot": "text"
      },
      {
        "name": "follow",
        "selector": ".odl-follow",
        "what": "a Follow toggle that reads Following when on",
        "slot": "action"
      },
      {
        "name": "photo",
        "selector": ".odl-pic",
        "what": "the square photo; a double click likes it",
        "slot": "media"
      },
      {
        "name": "photo_count",
        "selector": ".odl-count",
        "what": "which photo of how many, with dots below",
        "slot": "text"
      },
      {
        "name": "actions",
        "selector": ".odl-actions button",
        "what": "Like, Comment, Share and Save",
        "slot": "list"
      },
      {
        "name": "likes",
        "selector": ".odl-likes",
        "what": "who liked it and how many others",
        "slot": "rich"
      },
      {
        "name": "caption",
        "selector": ".odl-caption",
        "what": "the handle and a shortened caption that opens with more",
        "slot": "rich"
      },
      {
        "name": "comments_link",
        "selector": ".odl-text-btn",
        "what": "a button to view all comments",
        "slot": "action"
      },
      {
        "name": "top_comment",
        "selector": ".odl-top",
        "what": "one comment with a small photo and its own like",
        "slot": "rich"
      },
      {
        "name": "time",
        "selector": "time",
        "what": "how long ago it was posted",
        "slot": "text"
      }
    ],
    "data": {
      "type": "object",
      "required": [
        "author",
        "photo",
        "likes"
      ],
      "properties": {
        "author": {
          "type": "object",
          "required": [
            "handle"
          ],
          "properties": {
            "handle": {
              "type": "string",
              "maxLength": 30,
              "part": "author"
            },
            "photo": {
              "type": "string",
              "maxLength": 400,
              "part": "avatar"
            },
            "place": {
              "type": "string",
              "maxLength": 40,
              "part": "place"
            },
            "following": {
              "type": "boolean",
              "part": "follow"
            }
          }
        },
        "photo": {
          "type": "object",
          "required": [
            "src",
            "alt"
          ],
          "part": "photo",
          "properties": {
            "src": {
              "type": "string",
              "maxLength": 400
            },
            "alt": {
              "type": "string",
              "maxLength": 140
            }
          }
        },
        "photo_index": {
          "type": "integer",
          "minimum": 1,
          "part": "photo_count"
        },
        "photo_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "part": "photo_count"
        },
        "liked": {
          "type": "boolean",
          "part": "actions"
        },
        "saved": {
          "type": "boolean",
          "part": "actions"
        },
        "liked_by": {
          "type": "string",
          "maxLength": 24,
          "part": "likes"
        },
        "likes": {
          "type": "integer",
          "minimum": 0,
          "part": "likes"
        },
        "caption_short": {
          "type": "string",
          "maxLength": 90,
          "part": "caption"
        },
        "caption_full": {
          "type": "string",
          "maxLength": 600,
          "part": "caption"
        },
        "tags": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "part": "caption",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 24
              }
            }
          }
        },
        "comment_count": {
          "type": "integer",
          "minimum": 0,
          "part": "comments_link"
        },
        "top_comment": {
          "type": "object",
          "required": [
            "handle",
            "text"
          ],
          "part": "top_comment",
          "properties": {
            "handle": {
              "type": "string",
              "maxLength": 30
            },
            "photo": {
              "type": "string",
              "maxLength": 400
            },
            "text": {
              "type": "string",
              "maxLength": 140
            }
          }
        },
        "time": {
          "type": "string",
          "maxLength": 20,
          "part": "time"
        },
        "time_iso": {
          "type": "string",
          "maxLength": 24,
          "part": "time"
        },
        "author_photo": {
          "type": "object",
          "required": [
            "src",
            "alt"
          ],
          "properties": {
            "src": {
              "type": "string",
              "maxLength": 2048
            },
            "alt": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "author_handle": {
          "type": "string",
          "maxLength": 80
        },
        "author_place": {
          "type": "string",
          "maxLength": 80
        },
        "top_comment_photo": {
          "type": "object",
          "required": [
            "src",
            "alt"
          ],
          "properties": {
            "src": {
              "type": "string",
              "maxLength": 2048
            },
            "alt": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "top_comment_handle": {
          "type": "string",
          "maxLength": 80
        },
        "top_comment_text": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "edge": {
      "empty": {
        "status": "handled",
        "evidence": "data-od-list",
        "how": "the Smart UI renderer puts one plain 'Nothing to show yet.' line in an empty list"
      },
      "loading": {
        "status": "handled",
        "evidence": "data-od-slot",
        "how": "the Smart UI renderer draws each marked slot as a quiet block of its size while the data arrives; the static file shows the filled part"
      },
      "error": {
        "status": "not_built",
        "how": "if a like or follow fails, set the toggle back and say so with toast-stack"
      },
      "disabled": {
        "status": "not_built",
        "how": "set disabled on Comment and Share when the author has turned them off"
      },
      "overflow": {
        "status": "handled",
        "how": "in a narrow box the header and body padding shrink",
        "evidence": "@container (inline-size < 26rem)"
      },
      "long_text": {
        "status": "handled",
        "how": "a long handle or place ends in an ellipsis; a long caption stays short until more opens it",
        "evidence": ".odl-who b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap"
      },
      "missing_image": {
        "status": "handled",
        "evidence": "data-od-media",
        "how": "the Smart UI renderer swaps a photo that fails to load for a block of the same size with its alt text"
      }
    },
    "keyboard": [
      "Tab reaches Follow, More options, Like, Comment, Share, Save, more, View all comments and the comment's like",
      "Enter or Space on Like, Save, Follow or the comment's like switches it on or off; the like count changes with Like",
      "Enter or Space on more opens the full caption and the button then reads less",
      "liking by double click on the photo has no keyboard version; the Like button does the same",
      "More options, Comment, Share and View all comments are buttons with no action in the file"
    ]
  }
}
