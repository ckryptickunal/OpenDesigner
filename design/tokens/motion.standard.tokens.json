{
 "motion": {
  "transition": {
   "$type": "transition",
   "$description": "Semantic transitions, standard motion (DC-L04-24, DC-L04-25; reduced motion as a token mode).",
   "feedback": {
    "$value": {
     "duration": "{motion.duration.micro}",
     "delay": {
      "value": 0,
      "unit": "ms"
     },
     "timingFunction": "{motion.easing.standard}"
    },
    "$description": "Hover and press feedback."
   },
   "enter": {
    "$value": {
     "duration": "{motion.duration.medium}",
     "delay": {
      "value": 0,
      "unit": "ms"
     },
     "timingFunction": "{motion.easing.enter}"
    },
    "$description": "Popovers and menus entering."
   },
   "exit": {
    "$value": {
     "duration": "{motion.duration.short}",
     "delay": {
      "value": 0,
      "unit": "ms"
     },
     "timingFunction": "{motion.easing.exit}"
    },
    "$description": "Popovers and menus leaving (shorter than enter, DC-L04-24)."
   }
  }
 }
}
