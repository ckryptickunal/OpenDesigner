{
 "motion": {
  "transition": {
   "$type": "transition",
   "$description": "Semantic transitions, reduced motion (DC-L04-24, DC-L04-25; reduced motion as a token mode).",
   "feedback": {
    "$value": {
     "duration": "{motion.duration.micro}",
     "delay": {
      "value": 0,
      "unit": "ms"
     },
     "timingFunction": "{motion.easing.standard}"
    },
    "$description": "Unchanged: color and opacity feedback stays."
   },
   "enter": {
    "$value": {
     "duration": "{motion.duration.micro}",
     "delay": {
      "value": 0,
      "unit": "ms"
     },
     "timingFunction": "{motion.easing.standard}"
    },
    "$description": "Fade only: components drop translate and scale in this context (DC-L04-25)."
   },
   "exit": {
    "$value": {
     "duration": "{motion.duration.micro}",
     "delay": {
      "value": 0,
      "unit": "ms"
     },
     "timingFunction": "{motion.easing.standard}"
    },
    "$description": "Fade only (DC-L04-25)."
   }
  }
 }
}
