        },
        "price": {
          "type": "number",
          "part": "facts"
        },
        "currency": {
          "type": "string",
          "maxLength": 3,
          "part": "facts"
        },
        "calories": {
          "type": "string",
          "maxLength": 10,
          "part": "facts"
        },
        "tag": {
