{
  "name": "Menu item",
  "summary": "A restaurant dish as a sheet: a photo, description, a required choice, optional extras with prices and a limit, a note for the kitchen, quantity and an Add button with the live total.",
  "use": "when someone taps a dish on a restaurant or café menu",
  "type": "commerce",
  "style": "friendly",
  "industries": [
    "food"
  ],
  "tags": [
    "menu",
    "dish",
    "options",
    "extras",
    "add to order",
    "food delivery"
  ],
  "states": [
    "required unanswered",
    "required done",
    "extras at limit",
    "quantity",
    "hover",
    "focus"
  ],
  "source": null,
  "a11y": "The base and extras are native radio and checkbox groups whose whole row is the label; extras past the limit are disabled, the note has a label, the count is announced, and the Add button carries the live total.",
  "width": "narrow",
  "photos": [
    {
      "img": "photo-1546069901-ba9599a7e63c",
      "author": "Anh Nguyen",
      "page": "kcA-c3f_3FE"
    }
  ],
  "spec": {
    "use_when": [
      "any made-to-order product with one required choice and a few paid add-ons, such as a drink or a print size"
    ],
    "avoid_when": [
      "browsing many dishes at once: use restaurant-card for the place or product-card for each item",
      "a product with photos to swipe and sizes to compare: use product-gallery",
      "reviewing the whole order before paying: use cart-drawer or order-summary"
    ],
    "parts": [
      {
        "name": "photo",
        "selector": ".odl-photo img",
        "what": "the dish photo",
        "slot": "media"
      },
      {
        "name": "close",
        "selector": ".odl-close",
        "what": "closes the sheet",
        "slot": "action"
      },
      {
        "name": "flag",
        "selector": ".odl-flag",
        "what": "a short highlight above the name, such as how popular it is",
        "slot": "text"
      },
      {
        "name": "title",
        "selector": ".odl-menu-item h3",
        "what": "the dish name",
        "slot": "text"
      },
      {
        "name": "description",
        "selector": ".odl-desc",
        "what": "what is in the dish",
        "slot": "text"
      },
      {
        "name": "facts",
        "selector": ".odl-facts",
        "what": "the base price, calories and a tag such as spice level",
        "slot": "rich"
      },
      {
        "name": "base",
        "selector": ".odl-base .odl-opt",
        "what": "one required choice, with an extra price if it costs more",
        "slot": "list"
      },
      {
        "name": "required",
        "selector": ".odl-req",
        "what": "Required, Done or Optional beside each group's heading",
        "slot": "text"
      },
      {
        "name": "extras",
        "selector": ".odl-extras .odl-opt",
        "what": "one optional extra with its price; the rest disable at the limit",
        "slot": "list"
      },
      {
        "name": "note",
        "selector": "textarea",
        "what": "a note for the kitchen",
        "slot": "input"
      },
      {
        "name": "quantity",
        "selector": ".odl-step",
        "what": "one fewer, the count and one more",
        "slot": "number"
      },
      {
        "name": "add",
        "selector": ".odl-go",
        "what": "adds the dish to the order, with the live total",
        "slot": "action"
      }
    ],
    "data": {
      "type": "object",
      "required": [
        "title",
        "price",
        "currency"
      ],
      "properties": {
        "photo": {
          "type": "string",
          "maxLength": 300,
          "part": "photo"
        },
        "photo_alt": {
          "type": "string",
          "maxLength": 80,
          "part": "photo"
        },
        "flag": {
          "type": "string",
          "maxLength": 28,
          "part": "flag"
        },
        "title": {
          "type": "string",
          "maxLength": 48,
          "part": "title"
        },
        "description": {
          "type": "string",
          "maxLength": 200,
