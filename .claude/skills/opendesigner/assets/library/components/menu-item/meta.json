          "maxLength": 16,
          "part": "add"
        },
        "base_title": {
          "type": "string",
          "maxLength": 80
        },
        "base_options": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "note": {
                "type": "string",
                "maxLength": 80
              },
              "extra": {
                "type": "string",
                "maxLength": 80
              }
            }
          }
        },
        "extras_title": {
          "type": "string",
          "maxLength": 80
        },
        "extras_limit": {
          "type": "string",
          "maxLength": 80
        },
        "extras_options": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "price": {
                "type": "string",
                "maxLength": 80
              }
            }
          }
        }
      }
    },
    "edge": {
      "empty": {
        "status": "handled",
        "evidence": "data-od-list",
        "how": "the Smart UI renderer puts one plain 'Nothing to show yet.' line in an empty list"
      },
      "loading": {
        "status": "handled",
        "evidence": "data-od-slot",
        "how": "the Smart UI renderer draws each marked slot as a quiet block of its size while the data arrives; the static file shows the filled part"
      },
      "error": {
        "status": "handled",
        "how": "pressing Add with no base picked moves focus to the first base option, and the button says 'Pick a base' until one is chosen",
        "evidence": "if (first) { first.focus()"
      },
      "disabled": {
        "status": "shown",
        "how": "once three extras are ticked the others grey out, and One fewer is disabled at a quantity of 1",
        "evidence": "input:disabled + .odl-box"
      },
      "overflow": {
        "status": "not_built",
        "how": "a dish with many options makes the sheet tall; give the body a max height with its own scroll and keep the footer pinned"
      },
      "long_text": {
        "status": "handled",
        "how": "option labels wrap between the tick box and the price column; the note field can be made taller",
        "evidence": "grid-template-columns: auto minmax(0, 1fr) auto"
      },
      "missing_image": {
        "status": "handled",
        "evidence": "data-od-media",
        "how": "the Smart UI renderer swaps a photo that fails to load for a block of the same size with its alt text"
      }
    },
    "keyboard": [
      "Tab moves through Close, the base options as one radio group, each extra, the note, One fewer, One more and Add",
      "The arrow keys choose a base; Space ticks or unticks an extra",
      "Enter or Space on One fewer or One more changes the quantity, which is read out",
      "Enter on Add, or in an option, submits the dish"
    ]
  }
}
