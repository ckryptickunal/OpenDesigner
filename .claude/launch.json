{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "opendesigner-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--bind",
        "127.0.0.1",
        "--directory",
        "site/dist"
