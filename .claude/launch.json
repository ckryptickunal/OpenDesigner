    {
      "name": "opendesigner-library",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4174",
        "--bind",
        "127.0.0.1",
        "--directory",
        "site/.cache/library-dist"
      ],
      "port": 4174
    }
  ]
}
